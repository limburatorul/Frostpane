<Window x:Class="Fences.Ui.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Title="Fence">

    <Grid>
        <!-- The blurred wallpaper sample; transparent until the capture supplies one. -->
        <Border x:Name="Backdrop" CornerRadius="10" />

        <Border x:Name="Shell"
                CornerRadius="10"
                Background="#4D000000"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar: drag to move, double-click to roll up. -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="30" CornerRadius="9,9,0,0" Background="#22FFFFFF">
                    <TextBlock x:Name="TitleText"
                               Text="Fence"
                               Foreground="#F2FFFFFF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0" />
                </Border>

                <ScrollViewer x:Name="Body"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6,4,2,6">
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile"
                                        Width="86" Height="86"
                                        Margin="2"
                                        CornerRadius="6"
                                        Background="Transparent"
                                        Opacity="{Binding Opacity}"
                                        ToolTip="{Binding Name}">
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="{Binding Image}"
                                               Width="36" Height="36"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="30"
                                                   TextAlignment="Center"
                                                   Margin="3,4,3,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="#30FFFFFF" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

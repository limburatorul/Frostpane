<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray icon and the native context menus. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Frostpane</AssemblyName>
    <RootNamespace>Frostpane</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Version>1.2.1</Version>
    <Product>Frostpane</Product>
    <AssemblyTitle>Frostpane</AssemblyTitle>
    <Description>Desktop panes that group your icons, over a blurred wallpaper</Description>
    <Company>limburatorul</Company>
    <Copyright>Copyright Â© 2026</Copyright>
    <!-- DPI awareness must come from the manifest: WinForms' runtime API applies too late for WPF. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced in one file only; a global using would shadow WPF types everywhere. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>

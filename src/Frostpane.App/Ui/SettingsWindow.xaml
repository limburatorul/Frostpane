<Window x:Class="Frostpane.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frostpane settings"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B21"
        Foreground="#F0F0F4"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F0F4" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB4FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E7E8C" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F0F4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="40" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="820">
        <StackPanel Margin="20,16,20,16">

            <TextBlock Text="Blur" Style="{StaticResource Heading}" Margin="0,0,0,8" />

            <CheckBox x:Name="BlurBox" Content="Blur the wallpaper behind panes" Margin="0,0,0,2" />
            <TextBlock x:Name="BlurStatusText" Foreground="#8A93A6" FontSize="11" Margin="22,0,0,10" />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Softness" VerticalAlignment="Center" />
                <Slider x:Name="SoftnessSlider" Grid.Column="1" Minimum="1" Maximum="10" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=SoftnessSlider, StringFormat={}{0:0}}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Brightness" VerticalAlignment="Center" />
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="80" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}%}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="A dark wallpaper blurs to near black, which reads as a solid box. This lifts it until it reads as glass." />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="See-through" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Below 100% the live, unblurred wallpaper shows through the pane — a window rather than frost." />

            <TextBlock Text="Pane" Style="{StaticResource Heading}" />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour" VerticalAlignment="Center" />
                <Button x:Name="TintColorButton" Grid.Column="1" Height="22" Width="110"
                        HorizontalAlignment="Left" Content="Choose…" />
                <Border x:Name="TintSwatch" Grid.Column="2" Style="{StaticResource Swatch}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour strength" VerticalAlignment="Center" />
                <Slider x:Name="TintSlider" Grid.Column="1" Minimum="0" Maximum="60" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:0}%}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Colour laid over the blurred sample. The more of it, the less of the blur you see." />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Corner radius" VerticalAlignment="Center" />
                <Slider x:Name="CornerSlider" Grid.Column="1" Minimum="0" Maximum="20" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=CornerSlider, StringFormat={}{0:0}px}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="A pane docked to a screen edge keeps square corners along that edge." />

            <TextBlock Text="Title bar" Style="{StaticResource Heading}" />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Height" VerticalAlignment="Center" />
                <Slider x:Name="TitleHeightSlider" Grid.Column="1" Minimum="16" Maximum="40" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=TitleHeightSlider, StringFormat={}{0:0}px}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour" VerticalAlignment="Center" />
                <Button x:Name="TitleColorButton" Grid.Column="1" Height="22" Width="110"
                        HorizontalAlignment="Left" Content="Choose…" />
                <Border x:Name="TitleSwatch" Grid.Column="2" Style="{StaticResource Swatch}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour strength" VerticalAlignment="Center" />
                <Slider x:Name="TitleStrengthSlider" Grid.Column="1" Minimum="0" Maximum="100" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=TitleStrengthSlider, StringFormat={}{0:0}%}" />
            </Grid>

            <TextBlock Text="Border" Style="{StaticResource Heading}" />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour" VerticalAlignment="Center" />
                <Button x:Name="BorderColorButton" Grid.Column="1" Height="22" Width="110"
                        HorizontalAlignment="Left" Content="Choose…" />
                <Border x:Name="BorderSwatch" Grid.Column="2" Style="{StaticResource Swatch}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thickness" VerticalAlignment="Center" />
                <Slider x:Name="BorderThicknessSlider" Grid.Column="1" Minimum="0" Maximum="4" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=BorderThicknessSlider, StringFormat={}{0:0}px}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Colour strength" VerticalAlignment="Center" />
                <Slider x:Name="BorderStrengthSlider" Grid.Column="1" Minimum="0" Maximum="100" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=BorderStrengthSlider, StringFormat={}{0:0}%}" />
            </Grid>

            <TextBlock Text="Icons" Style="{StaticResource Heading}" />

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Size" VerticalAlignment="Center" />
                <Slider x:Name="IconSlider" Grid.Column="1" Minimum="24" Maximum="64" TickFrequency="2" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Value, ElementName=IconSlider, StringFormat={}{0:0}px}" />
            </Grid>

            <TextBlock Text="Behaviour" Style="{StaticResource Heading}" />
            <CheckBox x:Name="PeekBox" Content="Open a rolled-up pane while hovering it" />
            <CheckBox x:Name="AutostartBox" Content="Start with Windows" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="ResetButton" Content="Reset" Width="90" Height="28" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Content="Close" Width="90" Height="28" IsDefault="True" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>

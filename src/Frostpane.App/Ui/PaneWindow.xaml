<Window x:Class="Frostpane.Ui.PaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Title="Pane">

    <Grid>
        <!-- The glass: a blurred sample of the wallpaper, tinted. Its opacity is what decides
             whether the pane reads as frosted glass or as a solid box. -->
        <Grid x:Name="Glass">
            <Border x:Name="Backdrop" CornerRadius="10" />
            <Border x:Name="Tint" CornerRadius="10" Background="#73141419" />
        </Grid>

        <Border x:Name="Frame" CornerRadius="10" BorderBrush="#2EFFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar: drag to move, double-click to roll up. Double-clicking the name
                     itself asks to rename. -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="24" CornerRadius="9,9,0,0" Background="#22FFFFFF">
                    <Grid>
                        <TextBlock x:Name="TitleText"
                                   Text="Pane"
                                   Foreground="#F2FFFFFF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0" />

                    </Grid>
                </Border>

                <ScrollViewer x:Name="Body"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6,4,2,6">
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile"
                                        Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="2"
                                        CornerRadius="6"
                                        Background="Transparent"
                                        Opacity="{Binding Opacity}"
                                        ToolTip="{Binding Name}">
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="{Binding Image}"
                                               Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="30"
                                                   TextAlignment="Center"
                                                   Margin="3,4,3,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="#30FFFFFF" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
